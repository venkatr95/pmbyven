# Database
# Local dev (SQLite file, via better-sqlite3):
DATABASE_URL="file:./prisma/dev.db"

# Production (Turso — serverless libSQL, e.g. on Vercel/Netlify):
# Leave DATABASE_URL as-is above; setting these switches db.ts and the
# Prisma CLI over to Turso automatically. See docs/TURSO.md.
# TURSO_DATABASE_URL="libsql://your-db-name-your-org.turso.io"
# TURSO_AUTH_TOKEN="your_turso_auth_token"

# Admin (required). Change in production.
ADMIN_SECRET="change-me-to-a-strong-secret"

# Public site metadata (SEO) — production domain
NEXT_PUBLIC_SITE_NAME="pmbyven"
NEXT_PUBLIC_SITE_URL="https://pmbyven.com"
NEXT_PUBLIC_SITE_DESCRIPTION="A premium publication platform — if Apple designed Medium."
NEXT_PUBLIC_CONTACT_EMAIL="hello@pmbyven.com"

# Copyright & license (shown in footer and legal pages)
NEXT_PUBLIC_COPYRIGHT_HOLDER="pmbyven"
NEXT_PUBLIC_COPYRIGHT_YEAR="2026"
NEXT_PUBLIC_LICENSE_NAME="All Rights Reserved"
NEXT_PUBLIC_LICENSE_URL="/license"

# Crawl / bot control
# false (default) = noindex + robots Disallow: /
# true            = allow public indexing
ALLOW_SEARCH_INDEXING=false

# --- Optional: AI summaries (SpaceXAI / xAI) ---
# XAI_API_KEY=
# XAI_MODEL=grok-4-1-fast-non-reasoning
# XAI_BASE_URL=https://api.x.ai/v1

# --- Optional: newsletter fan-out integrations ---
# NEWSLETTER_WEBHOOK_URL=https://hooks.example.com/subscribe
# CONVERTKIT_API_KEY=
# CONVERTKIT_FORM_ID=
# BUTTONDOWN_API_KEY=
# MAILCHIMP_API_KEY=
# MAILCHIMP_AUDIENCE_ID=
# MAILCHIMP_SERVER_PREFIX=us21

# Optional: Vercel CLI / CI
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
